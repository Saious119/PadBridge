<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PadBridge.Gui.MainWindow"
        Title="PadBridge"
        Icon="avares://padbridge-gui/Assets/padbridge.png"
        Width="1080" Height="760"
        MinWidth="560" MinHeight="420">

  <Window.Styles>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.highlighted">
      <Setter Property="Background" Value="#5533AAFF" />
    </Style>
    <Style Selector="Button.target">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.target.capturing">
      <Setter Property="Background" Value="#553388FF" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- White button on the blue update bar; restate colors for the
         hover/press states or the theme washes them back out. -->
    <Style Selector="Button.update">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#1A3C6E" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.update:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E6EDF7" />
      <Setter Property="Foreground" Value="#1A3C6E" />
    </Style>
    <Style Selector="Button.update:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#C9D9EE" />
      <Setter Property="Foreground" Value="#1A3C6E" />
    </Style>
    <Style Selector="Button.update:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#AAB8CC" />
      <Setter Property="Foreground" Value="#801A3C6E" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">

    <!-- Toolbar: groups wrap onto extra lines when the window is narrow,
         so controls never overlap regardless of resolution. -->
    <DockPanel DockPanel.Dock="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Top" Margin="12,4,0,0">
        <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="Gray"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="checking..."
                   VerticalAlignment="Center" MinWidth="64" />
        <Button x:Name="PlayButton" Content="▶" FontSize="14"
                Foreground="#3FB950" ToolTip.Tip="Start the bridge service"
                Click="OnPlay" />
        <Button x:Name="StopButton" Content="■" FontSize="14"
                Foreground="#F85149" ToolTip.Tip="Stop the bridge service"
                Click="OnStop" />
      </StackPanel>

      <WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,16,2">
          <TextBlock Text="Controller:" VerticalAlignment="Center" />
          <ComboBox x:Name="DeviceCombo" MinWidth="180" MaxWidth="340"
                    SelectionChanged="OnDeviceSelected" />
          <Button x:Name="RefreshButton" Content="⟳" FontSize="16"
                  ToolTip.Tip="Rescan input devices" Click="OnRefresh" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,16,2">
          <TextBlock x:Name="ConfigLabel" Text="Config:" VerticalAlignment="Center"
                     ToolTip.ShowDelay="300" />
          <ComboBox x:Name="ConfigCombo" MinWidth="130" MaxWidth="260"
                    ToolTip.ShowDelay="300"
                    SelectionChanged="OnConfigSelected" />
          <Button x:Name="NewConfigButton" Content="＋" FontSize="14"
                  ToolTip.Tip="Create a new config (you'll name it when you save)"
                  Click="OnNewConfig" />
        </StackPanel>

        <CheckBox x:Name="GrabCheck" Content="Exclusive mode"
                  IsCheckedChanged="OnGrabChanged" Margin="0,2,0,2"
                  VerticalAlignment="Center" ToolTip.ShowDelay="300">
          <ToolTip.Tip>
            <TextBlock MaxWidth="340" TextWrapping="Wrap"
                       Text="Takes exclusive control of the controller and replaces it with a remapped copy. Required for button-to-button mappings to show up in games. Rumble is passed through.&#10;&#10;While the bridge is running in this mode it owns the controller, so stop it (■) before remapping here." />
          </ToolTip.Tip>
        </CheckBox>
      </WrapPanel>
    </DockPanel>

    <!-- Transient success/failure banner -->
    <Border x:Name="Banner" DockPanel.Dock="Top" CornerRadius="6"
            Padding="10,6" Margin="0,10,0,0" IsVisible="False">
      <TextBlock x:Name="BannerText" Foreground="White" TextWrapping="Wrap" />
    </Border>

    <!-- Update available bar (persistent until acted on) -->
    <Border x:Name="UpdateBar" DockPanel.Dock="Top" CornerRadius="6"
            Padding="10,6" Margin="0,10,0,0" Background="#2D5C9E" IsVisible="False">
      <DockPanel>
        <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Update now"
                Classes="update" Margin="12,0,0,0" Click="OnUpdateClick" />
        <TextBlock x:Name="UpdateText" Foreground="White" TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Bottom bar: hint + save -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="HintText" VerticalAlignment="Center"
                 Foreground="#888888" TextWrapping="Wrap"
                 Text="Press buttons on your controller to find them in the list." />
      <Button Grid.Column="1" x:Name="SaveButton" Content="Save config"
              Click="OnSave" />
    </Grid>

    <!-- Column headers + mapping list -->
    <Grid RowDefinitions="Auto,*" Margin="0,14,0,0">
      <Grid ColumnDefinitions="*,*,44" Margin="8,0,8,6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Controller input" FontWeight="Bold" VerticalAlignment="Center" />
          <Button x:Name="AddInputButton" Content="＋ Add input" FontSize="12"
                  Padding="8,2" Click="OnAddInput"
                  ToolTip.Tip="Listen for the next button press on the controller and add it to the list" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Mapped to" FontWeight="Bold" Margin="6,0,0,0"
                   VerticalAlignment="Center" />
      </Grid>

      <ScrollViewer Grid.Row="1">
        <ItemsControl x:Name="MappingList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="row" Classes.highlighted="{Binding IsHighlighted}">
                <Grid ColumnDefinitions="*,*,44">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding SourceLabel}"
                               IsVisible="{Binding !IsEditingName}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBox Text="{Binding NameDraft, Mode=TwoWay}"
                             IsVisible="{Binding IsEditingName}"
                             Watermark="Nickname (empty to reset)"
                             VerticalAlignment="Center" Margin="0,0,6,0"
                             KeyDown="OnNicknameKeyDown"
                             LostFocus="OnNicknameLostFocus" />
                    <Button Grid.Column="1" Content="✎" FontSize="12"
                            Margin="6,2" Opacity="0.6"
                            IsVisible="{Binding !IsEditingName}"
                            ToolTip.Tip="Give this input a nickname"
                            Click="OnRenameClick" />
                  </Grid>
                  <Button Grid.Column="1" Classes="target"
                          Classes.capturing="{Binding IsCapturing}"
                          Margin="6,2"
                          Click="OnRebindClick">
                    <TextBlock Text="{Binding TargetLabel}"
                               TextTrimming="CharacterEllipsis" />
                  </Button>
                  <Button Grid.Column="2" Content="✕" Margin="4,2,0,2"
                          ToolTip.Tip="Clear this mapping"
                          IsEnabled="{Binding HasTarget}"
                          Click="OnClearClick" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

  </DockPanel>
</Window>
